PORT=3000

# Port 55432 matches docker-compose.yml, which avoids clashing with a locally
# installed Postgres on 5432.
DATABASE_URL=postgres://blotato:blotato@localhost:55432/blotato_comments

# Disable on API-only instances so only worker instances poll and dispatch.
WORKERS_ENABLED=true

REPLY_MAX_ATTEMPTS=6
REPLY_DISPATCH_BATCH_SIZE=25
SYNC_POLL_BATCH_SIZE=20

# How old the mirror may be before a listing reports meta.stale
COMMENT_STALE_AFTER_SECONDS=120
